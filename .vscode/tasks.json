{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start (DEV)",
            "dependsOn": [
                "Start Frontend",
                "Start Desktop"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "uv run build.py",
            "problemMatcher": [],
            "presentation": {
                "panel": "shared"
            }
        },
        {
            "label": "Start Desktop",
            "type": "shell",
            "command": "uv run main.py",
            "options": {
                "env": {
                    "DEPLOCK_DEV": "1"
                },
                "statusbar": {
                    "hide" : true
                }
            },
            "presentation": {
                "group": "deplock",
                "panel": "shared"
            },
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "statusbar": {
                    "hide" : true
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            },
            "presentation": {
                "group": "deplock",
                "panel": "shared"
            },
        }
    ]
}
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Deplock (All)",
            "dependsOn": [
                "Start Backend",
                "Start Frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "uv run uvicorn app.main:app --app-dir backend --reload",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "deplock",
                "panel": "shared"
            }
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "deplock",
                "panel": "shared"
            }
        }
    ]
}